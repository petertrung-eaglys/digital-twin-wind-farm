kt:T01_nacelle_direction a sosa:Sensor ;
    rdfs:label "nacelle_direction T01" ;
    qudt:unit unit:DEG ;
    sosa:observes kt:NacelleDirection ;
    kt:attachedTo kt:T01_Nacelle ;
    kt:greenbyteSignalId 3 ;
    kt:manufacturerTitle "Nacelle orientation" ;
    kt:scadaColumn "Nacelle position (°)" ;
    kt:signalKey "nacelle_direction" ;
    kt:storedIn "data/processed/scada_T01.parquet" .

