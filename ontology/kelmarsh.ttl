# Schema
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix kt: <https://example.org/kelmarsh-twin#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

sosa:Sensor a rdfs:Class ;
    rdfs:label "Sensor" ;
    rdfs:comment "One SCADA signal of a turbine." .

kt:Alert a rdfs:Class ;
    rdfs:label "Alert" ;
    rdfs:comment "An underperformance alert period." .

kt:Component a rdfs:Class ;
    rdfs:label "Component" ;
    rdfs:comment "Superclass for turbine parts." .

kt:Dataset a rdfs:Class ;
    rdfs:label "Dataset" ;
    rdfs:comment "The published dataset all raw files come from." ;
    rdfs:subClassOf prov:Entity .

kt:Generator a rdfs:Class ;
    rdfs:label "Generator" ;
    rdfs:comment "The electrical generator." ;
    rdfs:subClassOf kt:Component .

kt:Nacelle a rdfs:Class ;
    rdfs:label "Nacelle" ;
    rdfs:comment "The nacelle housing on the tower." ;
    rdfs:subClassOf kt:Component .

kt:PowerModel a rdfs:Class ;
    rdfs:label "Power model" ;
    rdfs:comment "A trained model that predicts turbine power." ;
    rdfs:subClassOf prov:Entity .

kt:Rotor a rdfs:Class ;
    rdfs:label "Rotor" ;
    rdfs:comment "The rotor with hub and blades." ;
    rdfs:subClassOf kt:Component .

kt:SourceFile a rdfs:Class ;
    rdfs:label "Source file" ;
    rdfs:comment "A raw file of the dataset that graph facts or readings come from." ;
    rdfs:subClassOf prov:Entity .

kt:Turbine a rdfs:Class ;
    rdfs:label "Turbine" ;
    rdfs:comment "One wind turbine." .

kt:WindFarm a rdfs:Class ;
    rdfs:label "Wind farm" ;
    rdfs:comment "A wind farm site, here Kelmarsh." .

qudt:unit a rdf:Property ;
    rdfs:label "unit" ;
    rdfs:comment "QUDT unit of the signal." ;
    rdfs:domain sosa:Sensor ;
    rdfs:range qudt:Unit .

geo:lat a rdf:Property ;
    rdfs:label "latitude" ;
    rdfs:comment "WGS84 latitude." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

geo:long a rdf:Property ;
    rdfs:label "longitude" ;
    rdfs:comment "WGS84 longitude." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

prov:wasDerivedFrom a rdf:Property ;
    rdfs:label "was derived from" ;
    rdfs:comment "The source file a turbine's specs or a sensor's readings come from." ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

sosa:observes a rdf:Property ;
    rdfs:label "observes" ;
    rdfs:comment "The property the sensor measures." ;
    rdfs:domain sosa:Sensor ;
    rdfs:range sosa:ObservableProperty .

kt:attachedTo a rdf:Property ;
    rdfs:label "attached to" ;
    rdfs:comment "Sensor location." ;
    rdfs:domain sosa:Sensor ;
    rdfs:range kt:Component .

kt:commissioningDate a rdf:Property ;
    rdfs:label "commissioning date" ;
    rdfs:comment "Commercial operations date." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

kt:concerns a rdf:Property ;
    rdfs:label "concerns" ;
    rdfs:comment "Turbine of the alert." ;
    rdfs:domain kt:Alert ;
    rdfs:range kt:Turbine .

kt:doi a rdf:Property ;
    rdfs:label "DOI" ;
    rdfs:comment "Digital object identifier." ;
    rdfs:domain kt:Dataset ;
    rdfs:range rdfs:Literal .

kt:downloadUrl a rdf:Property ;
    rdfs:label "download URL" ;
    rdfs:comment "Zenodo URL." ;
    rdfs:domain kt:SourceFile ;
    rdfs:range rdfs:Literal .

kt:endTime a rdf:Property ;
    rdfs:label "end time" ;
    rdfs:comment "Alert end (UTC)." ;
    rdfs:domain kt:Alert ;
    rdfs:range rdfs:Literal .

kt:fileName a rdf:Property ;
    rdfs:label "file name" ;
    rdfs:comment "Raw file name." ;
    rdfs:domain kt:SourceFile ;
    rdfs:range rdfs:Literal .

kt:forTurbine a rdf:Property ;
    rdfs:label "for turbine" ;
    rdfs:comment "Modelled turbine." ;
    rdfs:domain kt:PowerModel ;
    rdfs:range kt:Turbine .

kt:greenbyteSignalId a rdf:Property ;
    rdfs:label "Greenbyte signal id" ;
    rdfs:comment "Signal id from the signal mapping file." ;
    rdfs:domain sosa:Sensor ;
    rdfs:range rdfs:Literal .

kt:hasComponent a rdf:Property ;
    rdfs:label "has component" ;
    rdfs:comment "A turbine part." ;
    rdfs:domain kt:Turbine ;
    rdfs:range kt:Component .

kt:hasSensor a rdf:Property ;
    rdfs:label "has sensor" ;
    rdfs:comment "A turbine's sensor." ;
    rdfs:domain kt:Turbine ;
    rdfs:range sosa:Sensor .

kt:hasTurbine a rdf:Property ;
    rdfs:label "has turbine" ;
    rdfs:comment "A turbine of the farm." ;
    rdfs:domain kt:WindFarm ;
    rdfs:range kt:Turbine .

kt:hubHeightM a rdf:Property ;
    rdfs:label "hub height (m)" ;
    rdfs:comment "Hub height." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

kt:license a rdf:Property ;
    rdfs:label "license" ;
    rdfs:comment "Dataset license." ;
    rdfs:domain kt:Dataset ;
    rdfs:range rdfs:Literal .

kt:lostEnergyMWh a rdf:Property ;
    rdfs:label "lost energy (MWh)" ;
    rdfs:comment "Sum of expected minus actual energy in the period." ;
    rdfs:domain kt:Alert ;
    rdfs:range rdfs:Literal .

kt:maeKW a rdf:Property ;
    rdfs:label "MAE (kW)" ;
    rdfs:comment "Test mean abs. error." ;
    rdfs:domain kt:PowerModel ;
    rdfs:range rdfs:Literal .

kt:manufacturer a rdf:Property ;
    rdfs:label "manufacturer" ;
    rdfs:comment "Maker." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

kt:manufacturerTitle a rdf:Property ;
    rdfs:label "manufacturer title" ;
    rdfs:comment "Manufacturer signal name from the signal mapping file." ;
    rdfs:domain sosa:Sensor ;
    rdfs:range rdfs:Literal .

kt:md5 a rdf:Property ;
    rdfs:label "MD5" ;
    rdfs:comment "Checksum of the file." ;
    rdfs:domain kt:SourceFile ;
    rdfs:range rdfs:Literal .

kt:meanResidualFraction a rdf:Property ;
    rdfs:label "mean residual fraction" ;
    rdfs:comment "Mean of (power - expected) / rated power in the period." ;
    rdfs:domain kt:Alert ;
    rdfs:range rdfs:Literal .

kt:modelFile a rdf:Property ;
    rdfs:label "model file" ;
    rdfs:comment "Path of the saved LightGBM model." ;
    rdfs:domain kt:PowerModel ;
    rdfs:range rdfs:Literal .

kt:nmae a rdf:Property ;
    rdfs:label "nMAE" ;
    rdfs:comment "MAE / rated power." ;
    rdfs:domain kt:PowerModel ;
    rdfs:range rdfs:Literal .

kt:partOf a rdf:Property ;
    rdfs:label "part of" ;
    rdfs:comment "The archive or dataset that contains the file." ;
    rdfs:domain kt:SourceFile ;
    rdfs:range prov:Entity .

kt:publisher a rdf:Property ;
    rdfs:label "publisher" ;
    rdfs:comment "Data owner." ;
    rdfs:domain kt:Dataset ;
    rdfs:range rdfs:Literal .

kt:raisedBy a rdf:Property ;
    rdfs:label "raised by" ;
    rdfs:comment "Model behind the alert." ;
    rdfs:domain kt:Alert ;
    rdfs:range kt:PowerModel .

kt:ratedPowerKW a rdf:Property ;
    rdfs:label "rated power (kW)" ;
    rdfs:comment "Rated power." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

kt:rotorDiameterM a rdf:Property ;
    rdfs:label "rotor diameter (m)" ;
    rdfs:comment "Diameter." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

kt:scadaColumn a rdf:Property ;
    rdfs:label "SCADA column" ;
    rdfs:comment "Original column name in the SCADA export." ;
    rdfs:domain sosa:Sensor ;
    rdfs:range rdfs:Literal .

kt:signalKey a rdf:Property ;
    rdfs:label "signal key" ;
    rdfs:comment "Config key and Parquet column name, e.g. power." ;
    rdfs:domain sosa:Sensor ;
    rdfs:range rdfs:Literal .

kt:startTime a rdf:Property ;
    rdfs:label "start time" ;
    rdfs:comment "Alert start (UTC)." ;
    rdfs:domain kt:Alert ;
    rdfs:range rdfs:Literal .

kt:storedIn a rdf:Property ;
    rdfs:label "stored in" ;
    rdfs:comment "Path of the Parquet file holding the time series." ;
    rdfs:domain sosa:Sensor ;
    rdfs:range rdfs:Literal .

kt:target a rdf:Property ;
    rdfs:label "target" ;
    rdfs:comment "The predicted signal." ;
    rdfs:domain kt:PowerModel ;
    rdfs:range sosa:Sensor .

kt:turbineId a rdf:Property ;
    rdfs:label "turbine id" ;
    rdfs:comment "Short id, e.g. T01." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

kt:turbineModel a rdf:Property ;
    rdfs:label "turbine model" ;
    rdfs:comment "Model name." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

kt:usesInput a rdf:Property ;
    rdfs:label "uses input" ;
    rdfs:comment "An input signal." ;
    rdfs:domain kt:PowerModel ;
    rdfs:range sosa:Sensor .


