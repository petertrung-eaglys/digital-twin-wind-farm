kt:T01 a kt:Turbine ;
    rdfs:label "Kelmarsh 1" ;
    geo:lat 52.400604 ;
    geo:long -0.947133 ;
    kt:hasComponent kt:T01_Generator,
        kt:T01_Nacelle,
        kt:T01_Rotor ;
    kt:hasSensor kt:T01_ambient_temp,
        kt:T01_nacelle_direction,
        kt:T01_pitch,
        kt:T01_power,
        kt:T01_rotor_speed,
        kt:T01_wind_direction,
        kt:T01_wind_speed ;
    kt:hubHeightM 78.5 ;
    kt:ratedPowerKW 2050.0 ;
    kt:rotorDiameterM 92.0 ;
    kt:turbineId "T01" .

kt:T01_Generator a kt:Generator ;
    rdfs:label "Generator T01" .

kt:T01_ambient_temp a sosa:Sensor ;
    rdfs:label "ambient_temp T01" ;
    qudt:unit unit:DEG_C ;
