        kt:PowerModel ;
    rdfs:label "Power model T01" ;
    prov:generatedAtTime "2026-11-12T00:25:42.442974+00:00"^^xsd:dateTime ;
    kt:forTurbine kt:T01 ;
    kt:maeKW 71.5630854952287 ;
    kt:nmae 0.03490882219279449 ;
    kt:target kt:T01_power ;
    kt:usesInput kt:T01_ambient_temp,
        kt:T01_wind_direction,
